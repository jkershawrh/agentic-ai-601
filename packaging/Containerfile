FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/nodejs-22@sha256:90d19cd1a4ba03bcb63c46320862955fc1560511532ee35ff472289bf5fe2276 AS build
WORKDIR /opt/app-root/src
COPY --chown=1001:0 package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY --chown=1001:0 index.html tsconfig*.json vite.config.ts ./
COPY --chown=1001:0 public ./public
COPY --chown=1001:0 src ./src
RUN npm run build:presentation

FROM --platform=linux/amd64 docker.io/library/golang@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS server-build
WORKDIR /src
COPY packaging/static-server.go .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /static-server static-server.go

FROM scratch
LABEL org.opencontainers.image.title="Agentic AI 601 rehearsal presentation" \
      org.opencontainers.image.description="Static research presentation; production execution and certification are not included" \
      org.opencontainers.image.vendor="Red Hat and Intel demo packaging" \
      org.opencontainers.image.source="https://github.com/jkershawrh/agentic-ai-601" \
      org.opencontainers.image.architecture="amd64"
COPY --from=server-build /static-server /static-server
COPY --from=build /opt/app-root/src/dist /site
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/static-server"]
